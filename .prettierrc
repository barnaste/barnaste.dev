{
    "useTabs": false,
    "tabWidth": 4,
    "singleQuote": false,
    "trailingComma": "all",
    "printWidth": 100,
    "endOfLine": "auto",
    "plugins": ["prettier-plugin-svelte"],
    "overrides": [
        {
            "files": "*.svelte",
            "options": { "parser": "svelte" }
        },
        {
            "files": "*.css",
            "options": { "tabWidth": 2 }
        }
    ]
}
